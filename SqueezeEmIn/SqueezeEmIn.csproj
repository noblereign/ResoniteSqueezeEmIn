<Project Sdk="Remora.Resonite.Sdk/2.1.0">
  <PropertyGroup>
    <ResoniteTarget>client</ResoniteTarget>
    <ResoniteProjectType>mod</ResoniteProjectType>
    <ResoniteTargetModLoader>ResoniteModLoaderStandalone</ResoniteTargetModLoader>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Change CopyToMods to true if you'd like builds to be moved into the Mods folder automatically-->
    <CopyToMods Condition="'$(CopyToMods)'==''">true</CopyToMods>
    <Configurations>Debug;Release;Headless</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Headless'">
    <ResoniteTarget>headless</ResoniteTarget>
    <AssemblyName>$(MSBuildProjectName)-Headless</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- If you don't want to provide a ResonitePath in dotnet build, you can specify one here -->
    <ResonitePath>$(MSBuildThisFileDirectory)Resonite/</ResonitePath>
    <ResonitePath Condition="Exists('C:\Program Files (x86)\Steam\steamapps\common\Resonite\')">C:\Program Files (x86)\Steam\steamapps\common\Resonite\</ResonitePath>
    <ResonitePath Condition="Exists('$(HOME)/.steam/steam/steamapps/common/Resonite/')">$(HOME)/.steam/steam/steamapps/common/Resonite/</ResonitePath>
    <ResonitePath Condition="Exists('P:\SteamLibrary\steamapps\common\Resonite\')">P:\SteamLibrary\steamapps\common\Resonite\</ResonitePath>
  </PropertyGroup>

  <ItemGroup>
    <ResoniteReference Include="FrooxEngine" />
    <ResoniteReference Include="Resonite" />
    <ResoniteReference Include="SkyFrost.Base" />
    <ResoniteReference Include="SkyFrost.Base.Models" />
    <Reference Include="HeadlessTweaks">
      <HintPath>$(ResonitePath)Headless\rml_mods\HeadlessTweaks.dll</HintPath>
      <HintPath>$(MSBuildThisFileDirectory)bin\HeadlessTweaks.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Locale\*.json" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(CopyToMods)'=='true'">
    <PropertyGroup>
      <!-- Set destination based on whether we are building the client or headless version -->
      <DeployFolder Condition="'$(ResoniteTarget)' == 'client'">$(ResonitePath)rml_mods</DeployFolder>
      <DeployFolder Condition="'$(ResoniteTarget)' == 'headless'">$(ResonitePath)Headless\rml_mods</DeployFolder>
    </PropertyGroup>

    <Message Text="Attempting to copy $(TargetFileName) to $(DeployFolder)" Importance="high" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(DeployFolder)" ContinueOnError="true" />
  </Target>
</Project>